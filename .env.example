SERVER_ENVIRONMENT="development"
SERVER_PORT="8080"

DATABASE_USER="techchallenge"
DATABASE_PASSWORD="CHANGE_ME"
DATABASE_HOST="db"
DATABASE_PORT="5432"
DATABASE_NAME="techchallenge-db"
DATABASE_MAX_CONNECTIONS="5"

# Precisa ser o MESMO valor configurado na Lambda do oficina-mecanica-serverless:
# ela assina o token, este servico so valida. Em producao vem do Secrets Manager.
JWT_SECRET_KEY="CHANGE_ME"

# URL publica usada para montar os links de aprovacao enviados por e-mail ao
# cliente. Em producao e o dominio do CloudFront + /api.
APP_BASE_URL="http://localhost:8080"

# mailhog (local) | ses (AWS)
EMAIL_PROVIDER="mailhog"
EMAIL_HOST="mailhog"
EMAIL_PORT=1025
EMAIL_FROM="oficina@workshop.local"

# Usados apenas quando EMAIL_PROVIDER=ses. As credenciais vem do IRSA do pod;
# nao existe access key aqui.
AWS_DEFAULT_REGION="sa-east-1"
SES_SENDER_EMAIL="oficina@example.com"
SES_REPLY_TO="oficina@example.com"
SES_CONFIG_SET=""
